{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ram-clinic-manager-canary",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ram-clinic-manager-canary-db",
      "database_id": "__SET_BY_GITHUB_ACTIONS__",
      "migrations_dir": "drizzle"
    }
  ]
}
